{
  "name": "last-haven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx apps/game-server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/apps/game-server/src/index.js",
    "check": "node scripts/check.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:gameplay": "tsx scripts/benchmark-gameplay.ts",
    "benchmark:aoi": "tsx scripts/benchmark-interest.ts",
    "load:local": "tsx scripts/load-local.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "playtest:internet": "tsx scripts/playtest.ts",
    "assets:hud": "tsx --env-file=.env scripts/generate-hud-icons.ts"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "pixi.js": "^8.13.2",
    "redis": "^6.2.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5"
  }
}
