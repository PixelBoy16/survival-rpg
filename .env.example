# Copy to .env and replace this local development password. Do not commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://haven:replace-with-a-local-password@127.0.0.1:5432/haven
REDIS_URL=redis://127.0.0.1:6379
SIMULATION_HZ=20
# Production topology is AWS Singapore; no deployment occurs from this file.
AWS_REGION=ap-southeast-1
# PixelLab API key for scripts/generate-hud-icons.ts (pnpm assets:hud).
PIXELLAB_API_KEY=
